; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[  ]
_global_script_class_icons={

}

[application]

config/name="Soviet Apartment"
config/description="3D exploration game in a Soviet apartment"
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=false
boot_splash/bg_color=Color( 0.1, 0.1, 0.1, 1 )
boot_splash/fullsize=false

[display]

window/size/width=1280
window/size/height=720
window/handheld/orientation="landscape"
window/energy_saving/keep_screen_on=true

[input]

move_forward={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":87,"unicode":0,"echo":false,"script":null)
 ]
}
move_back={
